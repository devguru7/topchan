# ============================================================================
# Topchan Ops — Environment Configuration (.env.example)
# Copy to .env for local development. Never commit real secrets to git.
# ============================================================================

# Server Port (defaults to 3000)
PORT="3000"

# APP_URL: Public URL where Topchan Ops is hosted (used for QR posters & links)
APP_URL="http://localhost:3000"

# Security: Server-side API Bearer token & CORS whitelist (REQUIRED in production)
# Generate a random 32+ byte secret for API_AUTH_TOKEN before deploying.
API_AUTH_TOKEN=""
CORS_ORIGIN="http://localhost:3000"

# GEMINI_API_KEY: Server-side Gemini AI key (@google/genai) for:
# - Smart Russian reception command parsing (/api/ai/parse-command)
# - In-memory passport photo MRZ OCR (/api/ai/mrz-ocr)
# - Multilingual guest reply drafting RU/EN/UZ/ZH (/api/ai/draft-reply)
# App stays 100% functional offline with deterministic local fallbacks if unset.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Bnovo PMS API v1 («Старт») — optional server-side integration
# Activate in Bnovo: Меню -> Bnovo Octopus -> API-доступ
BNOVO_ACCOUNT_ID=""
BNOVO_API_KEY=""

# Telegram Bot operational scheduler (Asia/Tashkent UTC+5) — optional
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Supabase Multi-Tenant Cloud Storage — optional browser & server sync
# When omitted, Topchan Ops runs automatically in offline-first LocalStorage mode.
# NEVER expose SUPABASE_SERVICE_ROLE_KEY to the browser (server-only).
SUPABASE_SERVICE_ROLE_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
VITE_PROPERTY_ID="topchan-tashkent-01"
